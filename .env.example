# Busca: Google Gemini interpreta o texto; o backend consulta e ordena o catálogo.
# Sem chave (ou se o provedor falhar), usa extração local por regras, sem embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Origem pública do portal, sem barra final. Configure em produção atrás de proxy.
# Exemplo: https://portal.exemplo.com.br
APP_ORIGIN=
# PostgreSQL: conexão do backend, nunca NEXT_PUBLIC_.
# No Supabase: Connect → Session pooler; copie a URI e substitua a senha.
DATABASE_URL=
DATABASE_SSL_CA_FILE=database/certificates/supabase-prod-ca-2021.crt

